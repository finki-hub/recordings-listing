{
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "eslint-config-imperium": "^4.1.5",
    "markdownlint-cli": "^0.49.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitepress": "^2.0.0-alpha.20",
    "vitepress-sidebar": "^1.40.0",
    "vue-tsc": "^3.3.13"
  },
  "license": "MIT",
  "name": "finki-hub-recordings-listing",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "npm run check && node --test tests/*.test.ts",
    "test:integration": "npm run check && playwright test",
    "build": "npm run check && vitepress build",
    "docs:build": "npm run build",
    "docs:dev": "vitepress dev",
    "docs:preview": "vitepress preview",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore .vitepress/dist",
    "lint:md:fix": "markdownlint \"**/*.md\" --ignore node_modules --ignore .vitepress/dist --fix",
    "check": "vue-tsc --noEmit",
    "lint": "eslint . --cache",
    "format": "eslint . --cache --fix",
    "lint:all": "npm run lint && npm run lint:md"
  },
  "type": "module",
  "version": "0.0.0",
  "dependencies": {
    "@lucide/vue": "^1.57.0",
    "@mdit-vue/shared": "^3.0.2",
    "posthog-js": "^1.438.12",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.44"
  }
}
